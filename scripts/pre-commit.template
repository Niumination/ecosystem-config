#!/bin/sh
# Niumination — pre-commit hook (installed via git templateDir)
# 3 checks: DOX cross-reference, .env blocker, gitleaks scan

echo "🔍 [Niumination] Running pre-commit checks..."

# === CHECK 1: DOX Cross-Reference (WARNING only) ===
# Jika source code (.ts,.tsx,.js,.jsx,.py,.go,.rs) berubah di stage
# tapi AGENTS.md dan BACKLOG.md tidak berubah → warning
changed_source=$(git diff --cached --name-only | grep -cE '\.(ts|tsx|js|jsx|py|go|rs)$' 2>/dev/null || echo 0)
changed_dox=$(git diff --cached --name-only | grep -cE '(AGENTS\.md|BACKLOG\.md)$' 2>/dev/null || echo 0)
if [ "$changed_source" -gt 0 ] && [ "$changed_dox" -eq 0 ]; then
  echo "⚠️  [DOX] Source code changed but AGENTS.md/BACKLOG.md not updated."
  echo "   Consider updating project DOX if architecture/API/credentials changed."
  # WARNING only — does not block
fi

# === CHECK 2: .env Blocker (BLOCK) ===
env_staged=$(git diff --cached --name-only | grep -cE '\.env$' 2>/dev/null || echo 0)
if [ "$env_staged" -gt 0 ]; then
  echo "❌ [ENV] .env files detected in staged changes! Commit blocked."
  echo "   Remove from staging: git reset HEAD -- <file>"
  echo "   Store credentials in ~/.hermes/ statt lokal .env"
  exit 1
fi

# === CHECK 3: Gitleaks — secret scan (BLOCK if leaks found) ===
if command -v gitleaks >/dev/null 2>&1; then
  # Try multiple locations for custom config
  CONFIG=""
  for try_path in "$HOME/.gitleaks.toml" "/Users/zaryu/.gitleaks.toml"; do
    [ -f "$try_path" ] && { CONFIG="$try_path"; break; }
  done
  if [ -n "$CONFIG" ]; then
    gitleaks git --pre-commit --config="$CONFIG" 2>/dev/null
  else
    gitleaks git --pre-commit 2>/dev/null
  fi
  if [ $? -ne 0 ]; then
    echo "❌ [GITLEAKS] Secrets detected! Commit blocked."
    echo "   Fix leaks before committing, or check ~/.gitleaks.toml"
    exit 1
  fi
  echo "✅ [GITLEAKS] No secrets detected."
else
  echo "⚠️  [GITLEAKS] Not installed — skipping secret scan."
fi

echo "✅ [Niumination] All checks passed."
exit 0
